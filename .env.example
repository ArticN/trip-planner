# Modelo das variáveis. Na Vercel, crie-as em Settings → Environment Variables.
# No computador, passe no terminal (ex.: APP_PASSWORD=minhasenha npm start) ou use: node --env-file=.env server/index.js
# Na nuvem: banco no Turso. Sem estas duas, o app usa o arquivo SQLite local (data/planner.db).
TURSO_DATABASE_URL=libsql://seu-banco-seu-usuario.turso.io
TURSO_AUTH_TOKEN=

# Senha para entrar no app. Sem ela, qualquer pessoa com o link vê e edita as viagens.
APP_PASSWORD=

# Só no computador
# DB_PATH=data/planner.db
# PORT=3000
